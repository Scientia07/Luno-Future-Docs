{
  "name": "lunolabs-remotion",
  "version": "1.0.0",
  "description": "Remotion video compositions for LunoLabs animations",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render src/index.ts DataFlow out/data-flow.mp4",
    "build:dataflow": "remotion render src/index.ts DataFlow out/data-flow.mp4",
    "build:code": "remotion render src/index.ts CodeWalkthrough out/code-walkthrough.mp4",
    "build:chart": "remotion render src/index.ts AnimatedChart out/animated-chart.mp4",
    "build:process": "remotion render src/index.ts ProcessDiagram out/process-diagram.mp4",
    "build:all": "npm run build:dataflow && npm run build:code && npm run build:chart && npm run build:process",
    "build:gif": "remotion render src/index.ts DataFlow out/data-flow.gif --image-format=png",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0",
    "recharts": "^2.10.0",
    "prism-react-renderer": "^2.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.3.0"
  }
}
